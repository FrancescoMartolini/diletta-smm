# Copia questo file in .env e inserisci i valori reali (vedi README.md).
# Sono tutti valori PUBBLICI per design: mai API secret in questo file.

# Cloudinary — cloud name (dashboard Cloudinary → Settings)
VITE_CLOUDINARY_CLOUD_NAME=

# Sanity — Project ID (sanity.io/manage)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
